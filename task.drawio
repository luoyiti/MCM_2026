    <diagram name="DWTS Dynamic Plackett-Luce Model" id="dwts-dpl-diagram">
        <mxGraphModel dx="926" dy="668" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="900" math="1" shadow="0">
